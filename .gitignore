# Python
.venv/
__pycache__/
*.pyc
.hypothesis/

# Secrets — never commit API keys
.env
*.key

# Build artifacts (reproducible via harness/build.sh)
build/

# OS
.DS_Store

# Local scaffolding / editor config — not deliverables
HANDOFF.md
.vscode/

# matrix shard scratch (merged JSONL + report are committed; shards/logs/status are not)
eval/matrix/*_shard*.jsonl
eval/matrix/*_shard*.log
eval/matrix/*.STATUS
eval/matrix/*.supervisor.log
eval/matrix/.shard_pids
runs/_batches/*.log
runs/_batches/*/loop.log

# finals-only subset of stage1a.jsonl (redundant scratch)
eval/matrix/stage1a_final.jsonl

# campaigns scratch (result JSONLs are committed)
eval/campaigns/STATUS
eval/campaigns/campaigns.log

# M2 run outputs — not included in the artifact
runs/tomlc99/M2*/
runs/_batches/m2-tomlc99/

# Paper content — uploaded separately, not part of the artifact
paper/
